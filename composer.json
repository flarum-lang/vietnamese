{
	"name": "flarum-lang/vietnamese",
	"description": "Vietnamese Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/vietnamese",
	"license": "MIT",
	"authors": [
		{
			"name": "datlechin",
			"homepage": "https://github.com/datlechin",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/vietnamese/issues",
		"forum": "https://discuss.flarum.org/d/28471",
		"source": "https://github.com/flarum-lang/vietnamese"
	},
	"require": {
		"flarum/core": "^1.4"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Vietnamese",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#00247d",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "vi",
			"title": "Tiếng Việt"
		}
	}
}
